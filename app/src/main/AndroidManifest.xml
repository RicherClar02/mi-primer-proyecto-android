<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Soporte de multiples pantallas.
        Se declara que la app sirve para pantallas pequenas, normales, grandes
        y extragrandes, y para cualquier densidad (anyDensity), que es lo que
        permite a Android escalar los recursos en vez de estirar pixeles.
    -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiPrimerProyecto">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hace que el idioma elegido dentro de la app tambien se recuerde en
            Android 12 o anterior. En Android 13+ lo guarda el sistema solo.
            El servicio nunca se ejecuta (enabled="false"): solo sirve para
            llevar la etiqueta autoStoreLocales que lee AppCompat.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
