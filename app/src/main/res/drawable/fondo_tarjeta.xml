<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta blanca semitransparente con esquinas redondeadas.
     Va encima del fondo nine-patch para que los textos se lean bien
     sin tapar del todo la ilustracion. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/tarjeta_fondo" />
    <corners android:radius="@dimen/radio_tarjeta" />
    <stroke
        android:width="1dp"
        android:color="@color/tarjeta_borde" />

</shape>
