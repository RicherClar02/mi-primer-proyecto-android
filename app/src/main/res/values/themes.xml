<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- El fondo nine-patch es una ilustracion clara (cielo azul), por eso el
         tema se fija en claro: asi los textos oscuros siempre contrastan,
         tambien cuando el telefono esta en modo oscuro. -->
    <style name="Theme.MiPrimerProyecto" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_android</item>
        <item name="colorOnPrimary">@color/azul_oscuro</item>
        <item name="colorSecondary">@color/azul_cielo</item>

        <!-- Barras de sistema transparentes: la ilustracion se ve de borde a
             borde (edge-to-edge). Los margenes de seguridad se aplican por
             codigo en MainActivity con los insets del sistema. -->
        <item name="android:statusBarColor">@color/transparente</item>
        <item name="android:navigationBarColor">@color/transparente</item>
        <item name="android:windowBackground">@color/azul_cielo</item>

        <!-- Si el usuario gira el telefono, que no se recorte nada -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- Estilo comun de los cuatro botones de idioma -->
    <style name="Boton.Idioma" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/altura_boton</item>
        <item name="android:textSize">@dimen/texto_boton_sp</item>
        <item name="android:textColor">@color/azul_oscuro</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/verde_android</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Boton.Entrada" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">108dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">@dimen/texto_boton_sp</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="strokeColor">@color/blanco</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
